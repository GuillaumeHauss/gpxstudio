# Use an official Node.js runtime as a parent image
FROM node:18-slim
# Set the working directory in the container
WORKDIR /usr/src/app

RUN npm install -g jest

# Bundle app source
COPY ./ ./

RUN npm install

RUN npm run test

# Make port 3000 available to the world outside this container
EXPOSE 3000

CMD [ "node", "index.js" ]
#ENTRYPOINT ["tail", "-f", "/dev/null"]
