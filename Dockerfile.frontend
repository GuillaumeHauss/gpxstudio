# Stage 1: Tester Environment
# This stage installs all dependencies and can be used to run E2E tests.
FROM mcr.microsoft.com/playwright/node:v1.44.0-jammy AS tester

WORKDIR /app

# Copy dependency definitions
COPY package.json package-lock.json ./

# Install dependencies
RUN npm install

# Copy the entire application code
COPY . .


# Stage 2: Production Environment
# This stage builds a lean Nginx image with only the static frontend files.
FROM nginx:1.25-alpine AS production

# Copy the static frontend files from the root
# Note: We are not using the 'tester' stage to copy from, as the source of truth is the repo context.
COPY --chown=nginx:nginx about.html /usr/share/nginx/html/
COPY --chown=nginx:nginx index.html /usr/share/nginx/html/
COPY --chown=nginx:nginx js /usr/share/nginx/html/js/
COPY --chown=nginx:nginx res /usr/share/nginx/html/res/
COPY --chown=nginx:nginx include /usr/share/nginx/html/include/
COPY --chown=nginx:nginx l /usr/share/nginx/html/l/
COPY --chown=nginx:nginx robots.txt /usr/share/nginx/html/
COPY --chown=nginx:nginx sitemap.xml /usr/share/nginx/html/
COPY --chown=nginx:nginx nginx.conf /etc/nginx/nginx.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
